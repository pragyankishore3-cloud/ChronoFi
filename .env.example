# ==============================================================
# ChronoFi Backend Environment Configuration Template
# ==============================================================

# Google Gemini API Key & Model
# Generate your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# JWT Security Keys
SECRET_KEY=your_256_bit_secret_key_here
JWT_SECRET_KEY=your_256_bit_secret_key_here

# Database & Engine Settings
DATABASE_URL=sqlite+aiosqlite:///./chronofi.db
ENVIRONMENT=development
PORT=8000
